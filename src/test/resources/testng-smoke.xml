<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Most important user journeys, run on every push. Framework self-tests run first: they are fast
     and a broken framework would make every UI test fail anyway. -->
<suite name="Smoke">
    <test name="Smoke">
        <groups>
            <run>
                <include name="framework"/>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.orangehrm.*"/>
        </packages>
    </test>
</suite>
