<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Every test, three classes at a time. Each test class instance holds its own WebDriver, so classes can run
     in parallel; methods of one class cannot until the driver is kept per thread.
     Tests in the "serial" group change or count shared state (system properties, the total number of
     employees), so they run afterwards on their own. -->
<suite name="Parallel">
    <test name="Parallel" parallel="classes" thread-count="3">
        <groups>
            <run>
                <exclude name="serial"/>
            </run>
        </groups>
        <packages>
            <package name="com.orangehrm.*"/>
        </packages>
    </test>
    <test name="Serial">
        <groups>
            <run>
                <include name="serial"/>
            </run>
        </groups>
        <packages>
            <package name="com.orangehrm.*"/>
        </packages>
    </test>
</suite>
